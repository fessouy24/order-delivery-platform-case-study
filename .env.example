# Copy to .env and generate new secret values. Never use previous project credentials.
APP_ENV=development
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
POSTGRES_DB=opsdemo
POSTGRES_USER=opsdemo
POSTGRES_PASSWORD=replace-with-a-generated-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
BUSINESS_TIMEZONE=Africa/Cairo
# Enable only behind the supplied proxy with private API networking.
TRUST_PROXY_CLIENT_IP=false
REQUIRE_STAFF_MFA=false
# Leave integration credentials blank until staging access is available.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_LOCATION_ID=
SHOPIFY_DELIVERY_DATE_ATTRIBUTE=delivery_date
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_VERSION=
ODOO_LOGIN=
ODOO_API_KEY=
# For website quotations, configure the verified Odoo partner record ID, not its display code.
ODOO_WEBSITE_PARTNER_ID=
ODOO_MARKET_IMPORT_ENABLED=false
# Verified Odoo company record ID; includes all brands except website quotations.
ODOO_MARKET_COMPANY_ID=
# Exact [customer record ID, shipping branch record ID] pairs; empty means no imports.
ODOO_MARKET_APPROVED_PAIRS=[]
# Explicit UTC creation timestamp; avoids importing historical quotations at activation.
ODOO_MARKET_IMPORT_FROM=
# Enable only after verifying the Odoo database, mappings and one draft quotation.
# Website quotations are released once per working day at 09:00 BUSINESS_TIMEZONE.
SHOPIFY_QUOTATION_BATCH_ENABLED=false
# Only for the reviewed production HTTPS overlay. Certificates are supplied externally.
PUBLIC_HOST=
TLS_CERTIFICATE_DIR=


# External writes remain disabled until the release acceptance gates pass.
TRIAL_MODE=false
SHOPIFY_FULFILLMENT_ENABLED=false
ODOO_COMPLETION_ENABLED=false
